A = [6, 15, 55; 5, 55, 225; 55, 225, 979]; 

[L, U, P] = lu(A); 

B = eye(3); 

A_inv = zeros(3, 3);

for i = 1:3
    % Get the i-th column of the identity matrix (b_i)
    b_i = B(:, i);
    
    % Apply permutation to the target vector
    Pb = P * b_i;
    
    % Forward Substitution: Solve L*y = P*b for y
    y = L \ Pb;
    
    % Backward Substitution: Solve U*x = y for x
    % This 'x' is the i-th column of the inverse matrix
    x = U \ y;
    
    % Store the result in the corresponding column of A_inv
    A_inv(:, i) = x;
end

% 5. Display Labeled Results
disp('--- Matrix A ---');
disp(A);

disp('--- Labeled Inverse Matrix (A_inv) ---');
disp('   Col 1 (x1)    Col 2 (x2)    Col 3 (x3)');
disp(A_inv);

% 6. Verification
% Compute A * A_inv. The result should be the Identity matrix.
Identity_Check = A * A_inv;

disp('--- Verification (A * A_inv) ---');
disp('Should be close to the Identity Matrix:');
disp(Identity_Check);
